#!/usr/bin/env bash

# script/update_bundles:
# This script brings every bundle checkout to main and pulls it, and names the
# ones it left alone. It wraps update_bundles.rb so it runs on the Ruby this
# project pins.

set -euo pipefail

cd "$(dirname "$0")/.."

# shellcheck source=script/_ruby.sh
source "$(dirname "$0")/_ruby.sh"

exec rv run ruby script/update_bundles.rb
